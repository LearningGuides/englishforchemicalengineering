---
interface Props {
  id: string;
  title: string;
  lessonNumber?: number;
}

const { id, title } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const lessonUrl = `${base}/lessons/${id}/`;
---

<article class="lesson-card">
  <h2>
    <a href={lessonUrl}>
      {title}
    </a>
  </h2>

  </article>